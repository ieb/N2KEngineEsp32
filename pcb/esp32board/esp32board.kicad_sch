	(text "ADS1115 at 64 SPS gives \nNyquist DC limit of 32Hz. RC Filters not \nneeded with sigma delta ADC.\n\nFor 1 LSB Error at 64 SPS, max input is 22K.\nusing 2.2K give 7mA worst case current. ADS max 10mA\n\nNot using clamp diodes to 5V as that would damage 5V chips"
		(exclude_from_sim no)
		(at 116.078 163.83 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "06cf6551-7dd2-475c-9bbd-94c0e38cda5e")
	)
	(text "ADS1115 Decouple"
		(exclude_from_sim no)
		(at 166.37 98.806 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "164ab07d-f845-4319-9286-fb3c7e2d8291")
	)
	(text "Flywheel sensor is a coil\n30 notches per revolution"
		(exclude_from_sim no)
		(at 254.254 53.594 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "46a2a55b-ff3d-4582-b410-e6ec4877d739")
	)
	(text "Decoupling must\nbe close to the LM393"
		(exclude_from_sim no)
		(at 148.336 28.448 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bc78b22e-97af-4d07-9d68-3559765d5efa")
	)
	(text "EngineBlock may be upto -ve relative to the GND\nbefore the ADC can no longer measure the drop."
		(exclude_from_sim no)
		(at 193.294 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d769cd6f-b509-4911-9851-33793e08a68c")
	)
	(text "10K Ok for 100KHz I2C\nUse 4K7 for 400KHz"
		(exclude_from_sim no)
		(at 57.912 80.518 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e3dae6fc-4601-42f2-8571-aabaee9b4487")
	)
	(text "The coolant sensor is fed from Engine Batt via a 1K resistor.\nEngine Batt+ terminal must be connected to the 1K resistor\nThe onboard 1K pullup R35 should only be added if not external."
		(exclude_from_sim no)
		(at 214.376 132.588 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ee57e505-ae65-4857-a38e-80340148917c")
	)
	(text "Check the pressure sensor has an isolated ground"
		(exclude_from_sim no)
		(at 272.796 81.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f53b9c98-30d8-43b1-a3bc-8a3bfbe1b462")
	)
	(text "12V can be any 12v source.\nGND Should be boat GNS not Engine block\nThere may be a voltage beween the Engine block and ground due to high charging current\ninduced by the alternator. The Ground of this board needs to be the central ground \nof the systems on the boat so that high currents do not influence it. It should be within\na few 10s of mv from the CAN ground and central grounding point to be able to accurately \nmeasure ground based voltages."
		(exclude_from_sim no)
		(at 245.364 75.946 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fe1f35fa-0bce-4f4d-a54e-39529cabdf8e")
	)
